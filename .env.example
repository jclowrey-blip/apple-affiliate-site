# SQLite database for the /pm tool. Path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Password for the /pm tool. When set, /pm requires signing in at /pm/login
# (in development and production). Use a long, unique one.
# PM_PASSWORD=

# With no password set, /pm is open in development and returns 404 in
# production builds unless this is set to 1.
# PM_ENABLED=1

# Needed only for the Assistant panel in /pm. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=
